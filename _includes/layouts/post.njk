{% extends "layouts/base.njk" %}

{% block extraHead %}
{%- set breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"},
    {"@type": "ListItem", "position": 2, "name": "Blog", "item": site.url + "/blog/"},
    {"@type": "ListItem", "position": 3, "name": title, "item": site.url + page.url}
  ]
} %}
<script type="application/ld+json">{{ breadcrumbSchema | dump | safe }}</script>
{%- set postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": (date | htmlDateString),
  "dateModified": ((updated or date) | htmlDateString),
  "author": {"@id": site.url + "/#person"},
  "publisher": {"@id": site.url + "/#organization"},
  "mainEntityOfPage": site.url + page.url,
  "image": (ogImage | default(site.ogImage))
} %}
<script type="application/ld+json">{{ postSchema | dump | safe }}</script>
<script type="application/ld+json">{{ site.personSchema | dump | safe }}</script>
{% endblock %}

{% block content %}
  <div class="pd-nav"><a href="/blog/">← Back to Blog</a><span>Studio Notes</span></div>
  <div class="pd-body">
    <p class="pd-eye rv">Studio Notes</p>
    <h1 class="pd-title rv d1">{{ title }}</h1>
    <p class="pd-sub rv d2">{{ description }}</p>
    <p class="pd-award rv d3"><span>◎</span> Published <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time> &middot; {{ site.name }}</p>
    <div class="post-content">
      {{ content | safe }}
    </div>
  </div>
{% endblock %}
