{% extends "layouts/base.njk" %}

{% block extraHead %}
{%- set breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"},
    {"@type": "ListItem", "position": 2, "name": "Blog", "item": site.url + "/blog/"},
    {"@type": "ListItem", "position": 3, "name": title, "item": site.url + page.url}
  ]
} %}
<script type="application/ld+json">{{ breadcrumbSchema | dump | safe }}</script>
<script type="application/ld+json">{{ { title: title, description: description, date: date, updated: updated, ogImage: ogImage, image: image, keywords: keywords, references: references } | articleSchema(site, page.url) | dump | safe }}</script>
{%- if faq %}
<script type="application/ld+json">{{ faq | faqSchema | dump | safe }}</script>
{%- endif %}
<meta property="article:published_time" content="{{ date | htmlDateString }}">
<meta property="article:modified_time" content="{{ (updated or date) | htmlDateString }}">
<meta property="article:author" content="{{ site.url }}/about.html">
<script type="application/ld+json">{{ site.personSchema | withContext | dump | safe }}</script>
{% endblock %}

{% block content %}
  <div class="pd-nav"><a href="/blog/">← Back to Blog</a><span>{{ category | default("Studio Notes") }}</span></div>
  <article class="pd-body">
    <p class="pd-eye rv">{{ category | default("Studio Notes") }}</p>
    <h1 class="pd-title pd-title-post rv d1">{{ title }}</h1>
    <p class="pd-sub rv d2">{{ description }}</p>
    <p class="pd-award rv d3"><span>◎</span> By <a href="/about.html">{{ site.name }}</a> &middot; Published <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>{% if updated %} &middot; Updated <time datetime="{{ updated | htmlDateString }}">{{ updated | readableDate }}</time>{% endif %}</p>
    {%- if image %}
    <figure class="post-cover rv">
      <picture>
        {%- if imageWebp %}<source srcset="{{ imageWebp }}" type="image/webp">{% endif %}
        <img src="{{ image }}" alt="{{ imageAlt | default(title) }}" width="{{ imageWidth | default(1200) }}" height="{{ imageHeight | default(1200) }}" loading="eager" fetchpriority="high">
      </picture>
    </figure>
    {%- endif %}
    <div class="post-content">
      {{ content | safe }}
    </div>
    {%- if faq %}
    <section class="post-faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Frequently asked questions</h2>
      {%- for f in faq %}
      <details class="faq-item"{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {%- endfor %}
    </section>
    {%- endif %}
    {%- if references %}
    <section class="post-refs" aria-labelledby="refs-h">
      <h2 id="refs-h">References (PubMed-indexed)</h2>
      <ol>
        {%- for r in references %}
        <li id="ref-{{ r.n }}" value="{{ r.n }}">{{ r.text }} <a href="https://pubmed.ncbi.nlm.nih.gov/{{ r.pmid }}/" target="_blank" rel="noopener">PubMed {{ r.pmid }}</a> &middot; <a href="https://doi.org/{{ r.doi }}" target="_blank" rel="noopener">DOI</a></li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}
    <aside class="post-author">
      <p class="s-eye">About the author</p>
      <p><strong>{{ site.name }}</strong> is an oral and maxillofacial surgeon and head and neck surgical oncologist practising in Kochi, Kerala. <a href="/about.html">Read more</a> or <a href="/contact.html#book">book a consultation</a>.</p>
      <p class="post-disclaimer">This article is for general education and is not a substitute for personal medical advice, examination or treatment planning.</p>
    </aside>
  </article>
{% endblock %}
